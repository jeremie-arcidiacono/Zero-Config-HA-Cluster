---
config:
  flowchart:
    htmlLabels: false
    nodeSpacing: 22
    rankSpacing: 45
  htmlLabels: false
  theme: base
  themeVariables:
    edgeLabelBackground: "#FFFFFF"
---
flowchart TD
    START([Démarrage]) --> starting[starting]
    starting --> check{"État persisté ?"}

    check -->|"Aucun"| discovering
    check -->|"Valide"| rejoin["rejoin_cluster"]
    check -->|"Illisible"| rejoin_failed["rejoin_failed"]

    discovering["fb_discovering"]
    bootstrap["fb_bootstrapping"]
    joining["fb_joining"]
    discovering -->|"Création\ndemandée"| bootstrap
    discovering -->|"Cluster\njoignable"| joining
    bootstrap -->|"Cluster\nétranger"| joining

    bootstrap --> OPS
    joining --> stable_agent
    rejoin --> OPS
    rejoin -->|"Rôle\nincohérent"| rejoin_failed

    subgraph OPS["Opération"]
        stable_server(["stable_server"])
        stable_agent(["stable_agent"])
    end

    OPS <--> rescaling[/"Redimensionnement\n(figure suivante)"/]
    OPS -->|"Arrêt"| END([Fin])
    OPS -->|"POST /decommission"| decommissioning["decommissioning"]

    decommissioning --> END

    classDef borne fill:#ECEFF1,stroke:#546E7A,color:#263238
    classDef decision fill:#FFF9C4,stroke:#F57F17,color:#000
    classDef init fill:#BBDEFB,stroke:#0D47A1,color:#000
    classDef stable fill:#C8E6C9,stroke:#1B5E20,stroke-width:2px,color:#000
    classDef transition fill:#FFE0B2,stroke:#E65100,color:#000
    classDef terminal fill:#FFCDD2,stroke:#B71C1C,color:#000

    class START,END borne
    class check decision
    class starting,discovering,bootstrap,joining,rejoin init
    class stable_server,stable_agent stable
    class rescaling transition
    class rebooting,decommissioning,rejoin_failed terminal
