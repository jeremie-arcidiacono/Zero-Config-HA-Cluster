---
config:
  theme: base
  sequence:
    actorMargin: 30
    messageMargin: 18
    boxTextMargin: 4
    noteMargin: 6
    width: 100

    mirrorActors: false
  themeVariables:
    actorBkg: "#BBDEFB"
    actorBorder: "#0D47A1"
    actorTextColor: "#000000"
    noteBkgColor: "#FFF9C4"
    noteBorderColor: "#F57F17"
    noteTextColor: "#000000"
